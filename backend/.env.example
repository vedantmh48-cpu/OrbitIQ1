# =============================================================================
# SatQuery AI - backend environment configuration
# Copy to `.env` and adjust. All values have safe development defaults.
# =============================================================================

APP_NAME=SatQuery AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated list of extra allowed origins
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# MongoDB
#   URI must include credentials if required: mongodb://user:pass@host:27017
#   DB_MODE: auto -> MongoDB when reachable, else local JSON store
#            on   -> require MongoDB (fail fast)
#            off  -> always use local JSON store
# -----------------------------------------------------------------------------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=satquery_dev
DB_MODE=auto

# -----------------------------------------------------------------------------
# Auth / security (change the secret in production!)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_HOURS=2
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# Auth store / sessions (v1 auth vertical slice)
#   AUTH_STORE: auto -> PostgreSQL (PostGIS) when reachable, else legacy store
#               postgres -> require PostgreSQL (fail fast)
#               compat  -> always use the legacy document store
#   Redis keeps hot session metadata; train runs fine without it (in-memory
#   fallback is used).
# -----------------------------------------------------------------------------
AUTH_STORE=auto
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/satquery
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=auto

# 6-digit OTP codes & password-change window (minutes)
AUTH_OTP_TTL_MINUTES=10
AUTH_PASSWORD_CHANGE_TTL_MINUTES=10

# Inactivity auto-logout
DEFAULT_INACTIVITY_TIMEOUT_MINUTES=15
# Government/Defense orgs are clamped to this maximum (never "Never")
GOV_MAX_INACTIVITY_TIMEOUT_MINUTES=15
SESSION_IDLE_TOUCH_SECONDS=5

# -----------------------------------------------------------------------------
# Rate limiting / hardening
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=30

# -----------------------------------------------------------------------------
# Demo vs real satellite data
#   DEMO_MODE: auto -> demo data unless real provider keys are configured
#              on   -> demo data always available
#              off  -> only real providers (may return no data)
# -----------------------------------------------------------------------------
DEMO_MODE=auto

# Optional LLM for advanced query understanding / summaries
LLM_API_KEY=
LLM_MODEL=

# Google AI Studio Gemini: enables Google Search-grounded current research in
# POST /api/queries/research and research included with /understand.
# Create a key at https://aistudio.google.com/app/apikey. Keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# -----------------------------------------------------------------------------
# Historical change analysis (Date 1 vs Date 2)
#   CHANGE_ANALYSIS_ENABLED : on/off the whole feature
#   CHANGE_IMAGERY_MODE  : auto -> query STAC Earth Search for real scene
#                          metadata, fall back to deterministic demo rasters
#                          demo -> always synthetic demo scenes (offline)
#   CHANGE_LLM_API_KEY   : when set, an OpenAI-compatible vision model inspects
#                          the heatmap + composites and writes the report
#                          interpretation. Falls back to the deterministic
#                          template on any failure. Defaults to LLM_API_KEY.
#   CHANGE_LLM_BASE_URL  : OpenAI / Azure / OpenRouter / vLLM-Ollama endpoint
# -----------------------------------------------------------------------------
CHANGE_ANALYSIS_ENABLED=true
CHANGE_IMAGERY_MODE=auto
CHANGE_MAX_CELLS=16900
CHANGE_IMAGE_SIZE=360
CHANGE_DEFAULT_BUFFER_KM=1.0
CHANGE_LLM_API_KEY=
CHANGE_LLM_BASE_URL=https://api.openai.com/v1
CHANGE_LLM_MODEL=gpt-4o-mini
CHANGE_LLM_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Real satellite providers (leave empty until you have keys)
# -----------------------------------------------------------------------------
# Sentinel (Copernicus Data Space)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=
# USGS Landsat M2M
LANDSAT_API_KEY=
# NASA Earthdata
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# -----------------------------------------------------------------------------
# E-mail delivery (SMTP) - Gmail by default.
#   Every credential comes from the environment: nothing is hard-coded and the
#   app password is never logged or returned by the API.
#   MAIL_ENABLED: auto -> send when host + username + password are present
#                 true -> force sending            false -> never send
#   When mail is disabled/unreachable the OTP flows fall back to the local
#   `demo_code` response field so development keeps working offline.
#
#   Gmail setup:
#     1. Enable 2-Step Verification on the Google account.
#     2. Create an App Password: https://myaccount.google.com/apppasswords
#     3. SMTP_USERNAME = the full Gmail address
#        SMTP_PASSWORD = the 16-character App Password (spaces are stripped)
#     For a Google Workspace domain the sender must be that mailbox (or an
#     alias configured in Gmail) - leave SMTP_FROM empty to use SMTP_USERNAME.
# -----------------------------------------------------------------------------
MAIL_ENABLED=auto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# STARTTLS (port 587) is the default; set SMTP_USE_SSL=true for implicit SSL (465)
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: GMAIL_APP_PASSWORD is accepted as an alias for SMTP_PASSWORD
SMTP_FROM=
SMTP_FROM_NAME=SatQuery AI
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=15
# "New sign-in" security alert e-mails after every successful login (incl. MFA)
LOGIN_NOTIFICATION_ENABLED=true
# Public base URL used inside e-mail links (defaults to FRONTEND_ORIGIN)
APP_PUBLIC_URL=

# -----------------------------------------------------------------------------
# Google Docs report publishing (OAuth)
#   When configured, "Publish to Google Docs" on any result creates a real
#   Google Document in the user's Drive. Otherwise the app offers a
#   Google-Docs-compatible .docx download, so the feature always works.
#   Create OAuth 2.0 Web client credentials at
#   https://console.cloud.google.com/apis/credentials
#   (authorized redirect URI must match GOOGLE_REDIRECT_URI below)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/reports/google/callback

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# DATA_DIR=./data
# LOCAL_DB_FILE=./data/local_db.json
# LOG_FILE=./data/satquery.log

# -----------------------------------------------------------------------------
# Production deployment overrides (set in the backend host's secret/env UI;
# these are placeholders and must be replaced with your real service values).
# The defaults above are for local development only.
# -----------------------------------------------------------------------------
# ENVIRONMENT=production
# FRONTEND_ORIGIN=https://YOUR_VERCEL_DOMAIN
# CORS_ORIGINS=https://YOUR_VERCEL_DOMAIN,https://YOUR_VERCEL_PREVIEW_DOMAIN
# JWT_SECRET=<unique-long-random-secret>
# DB_MODE=on
# MONGO_URI=<managed-mongodb-connection-uri>
# MONGO_DB=satquery
# AUTH_STORE=postgres
# POSTGRES_DSN=<managed-postgresql-postgis-connection-uri>
# REDIS_ENABLED=on
# REDIS_URL=<managed-redis-connection-uri>
# GOOGLE_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/reports/google/callback
# APP_PUBLIC_URL=https://YOUR_VERCEL_DOMAIN
